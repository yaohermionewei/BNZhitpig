page {
  background: #ff7655;
}

.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #ff7655;
}

.page-light {
  background: #ff7655;
}

.page-dark {
  background: #fff1c8;
}

.result-bg-base,
.result-bg-glow,
.result-bg-veil,
.result-bg-vignette {
  position: absolute;
  inset: 0;
}

.result-bg-base {
  z-index: 1;
}

.result-bg-glow {
  z-index: 2;
}

.result-bg-veil {
  z-index: 3;
}

.result-bg-vignette {
  z-index: 4;
}

.result-parchment-bg {
  position: absolute;
  inset: 0;
  z-index: 5;
  display: block;
  width: 100%;
  height: 100%;
}

.page-light.result-bg-parchment,
.page-dark.result-bg-parchment {
  background: #c59247;
}

.page-light.result-bg-parchment .result-bg-base,
.page-dark.result-bg-parchment .result-bg-base {
  background: #c59247;
}

.page-light.result-bg-parchment .result-bg-glow,
.page-light.result-bg-parchment .result-bg-veil,
.page-light.result-bg-parchment .result-bg-vignette,
.page-dark.result-bg-parchment .result-bg-glow,
.page-dark.result-bg-parchment .result-bg-veil,
.page-dark.result-bg-parchment .result-bg-vignette {
  background: none;
}

.page-light .result-bg-base {
  background: #ff7655;
}

.page-light .result-bg-glow {
  background:
    radial-gradient(
      ellipse 83.529vw 79.789vh at 50.195vw 88.441vh,
      #fff5dc 0%,
      #fff5dc 8%,
      #ffd666 48%,
      rgba(255, 214, 102, 0.55) 68%,
      rgba(255, 214, 102, 0) 100%
    );
}

.page-light .result-bg-veil {
  background: none;
}

.page-light .result-bg-vignette {
  background: none;
}

.page-dark .result-bg-base {
  background:
    radial-gradient(circle at 50% 12%, rgba(255, 251, 233, 0.92), rgba(255, 251, 233, 0) 22%),
    linear-gradient(180deg, #ff9865 0%, #ffb66e 18%, #ffd67f 42%, #ffe8a8 74%, #fff6dc 100%);
}

.page-dark .result-bg-glow {
  background:
    radial-gradient(circle at 50% 26%, rgba(255, 250, 216, 0.9), rgba(255, 250, 216, 0.36) 22%, rgba(255, 250, 216, 0) 50%),
    radial-gradient(circle at 50% 88%, rgba(255, 250, 231, 0.62), rgba(255, 250, 231, 0) 42%);
}

.page-dark .result-bg-veil {
  background:
    linear-gradient(180deg, rgba(124, 67, 28, 0.04) 0%, rgba(124, 67, 28, 0.02) 42%, rgba(76, 33, 19, 0.08) 100%),
    radial-gradient(circle at 50% 18%, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0) 38%);
}

.page-dark .result-bg-vignette {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 16%, rgba(89, 47, 40, 0) 72%, rgba(89, 47, 40, 0.1) 100%);
}

.page-dark.result-page-failed .result-bg-base {
  background:
    radial-gradient(circle at 50% 12%, rgba(255, 247, 235, 0.9), rgba(255, 247, 235, 0) 24%),
    linear-gradient(180deg, #ff9d7e 0%, #ffba87 18%, #ffd89a 42%, #ffe8b7 74%, #fff3df 100%);
}

.page-dark.result-bg-parchment.result-page-failed .result-bg-base {
  background: #c59247;
}

.result-shell {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 28rpx 66rpx;
  padding-bottom: calc(66rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.result-stage,
.result-actions {
  width: 94%;
  max-width: 668rpx;
}

.result-stage {
  position: relative;
  padding-top: 12rpx;
  box-sizing: border-box;
}

.result-sparkles {
  position: absolute;
  top: 8rpx;
  left: 0;
  right: 0;
  height: 340rpx;
  pointer-events: none;
  z-index: 2;
}

.result-spark {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  color: #ffd35e;
  background:
    linear-gradient(currentColor, currentColor) center / 16% 16% no-repeat,
    linear-gradient(0deg, rgba(255, 220, 104, 0) 0%, currentColor 48%, currentColor 52%, rgba(255, 220, 104, 0) 100%) center / 12% 100% no-repeat,
    linear-gradient(90deg, rgba(255, 220, 104, 0) 0%, currentColor 48%, currentColor 52%, rgba(255, 220, 104, 0) 100%) center / 100% 12% no-repeat,
    linear-gradient(45deg, rgba(255, 247, 204, 0) 0%, rgba(255, 247, 204, 0.94) 49%, rgba(255, 247, 204, 0.94) 51%, rgba(255, 247, 204, 0) 100%) center / 70% 10% no-repeat,
    linear-gradient(-45deg, rgba(255, 247, 204, 0) 0%, rgba(255, 247, 204, 0.94) 49%, rgba(255, 247, 204, 0.94) 51%, rgba(255, 247, 204, 0) 100%) center / 70% 10% no-repeat;
  opacity: 0.5;
  box-shadow:
    0 0 3rpx rgba(255, 248, 205, 0.68),
    0 0 8rpx rgba(255, 190, 76, 0.22);
  animation: result-spark-twinkle 940ms steps(1, end) infinite;
}

