}

.result-song-title-segment {
  display: block;
  flex: 0 1 auto;
  min-width: 0;
  height: 84rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 28px;
  line-height: 84rpx;
  color: #654915;
  transform: translateY(-2rpx);
}

.result-divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 18rpx 0 22rpx;
}

.result-divider-line {
  flex: 1 1 auto;
  height: 4rpx;
  background: repeating-linear-gradient(
    90deg,
    rgba(232, 192, 140, 0.92) 0 10rpx,
    rgba(232, 192, 140, 0) 10rpx 18rpx
  );
}

.result-divider-star {
  flex: 0 0 18rpx;
  width: 18rpx;
  height: 18rpx;
  background:
    linear-gradient(#e8c08c, #e8c08c) center / 4rpx 100% no-repeat,
    linear-gradient(#e8c08c, #e8c08c) center / 100% 4rpx no-repeat;
  box-shadow: 0 0 8rpx rgba(232, 192, 140, 0.34);
}

.result-page-failed .result-divider-line {
  background: repeating-linear-gradient(
    90deg,
    rgba(232, 192, 140, 0.92) 0 10rpx,
    rgba(232, 192, 140, 0) 10rpx 18rpx
  );
}

.result-page-failed .result-divider-star {
  background:
    linear-gradient(#e8c08c, #e8c08c) center / 4rpx 100% no-repeat,
    linear-gradient(#e8c08c, #e8c08c) center / 100% 4rpx no-repeat;
  box-shadow: 0 0 8rpx rgba(232, 192, 140, 0.34);
}

.result-main-row {
  width: 100%;
}

.result-score-stack {
  width: 100%;
  min-width: 0;
}

.result-score-rank-row {
  width: 100%;
  margin-top: calc(36rpx - 20px);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.result-score-label-text {
  font-size: 18px;
  letter-spacing: 0;
  color: rgba(111, 64, 33, 0.6);
}

.result-score-value-wrap {
  flex: 1 1 auto;
  min-width: 0;
  min-height: 126rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.result-digit-run {
  display: flex;
  align-items: flex-start;
  flex-wrap: nowrap;
  line-height: 0;
}

.result-digit-glyph {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
}

.result-digit-row {
  flex: 0 0 auto;
  display: flex;
}

.result-digit-pixel {
  flex: 0 0 auto;
  background: transparent;
}

.result-digit-pixel-filled {
  background: #582f28;
}

.result-score-digit-run {
  flex: 0 1 auto;
  gap: 0;
  max-width: 100%;
  overflow: hidden;
}

.result-score-digit-run .result-digit-row {
  height: 3px;
}

.result-score-digit-run .result-digit-pixel {
  width: 3px;
  height: 3px;
}

.result-rank-block {
  flex: 0 0 132rpx;
  min-width: 0;
}

.result-rank-face {
  min-height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  box-sizing: border-box;
}

.result-rank-text {
  line-height: 0.9;
  letter-spacing: -2rpx;
  color: #ffd14a;
  text-shadow:
    0 6rpx 0 #90511f,
    3rpx 0 0 #90511f,
    -3rpx 0 0 #90511f,
    3rpx 3rpx 0 #90511f,
    -3rpx 3rpx 0 #90511f,
    3rpx -3rpx 0 #90511f,
    -3rpx -3rpx 0 #90511f;
  transform: translateY(-4rpx);
}

.result-rank-text-standard {
  font-size: 52px;
}

.result-rank-text-compact {
  font-size: 46px;
}

.result-rank-text-ultra-compact {
  font-size: 34px;
}

.result-rank-tone-prism .result-rank-text {
  color: #ffcf4d;
}

.result-rank-tone-mint .result-rank-text {
  color: #8ed881;
}

.result-rank-tone-sky .result-rank-text {
  color: #89c8ff;
}

.result-rank-tone-violet .result-rank-text {
  color: #c59ff5;
}

.result-rank-tone-rose .result-rank-text {
  color: #f28a95;
}

.result-stats-grid {
  margin-top: 16rpx;
}

.result-stat-card {
  min-height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 8rpx 0;
  box-sizing: border-box;
  background: repeating-linear-gradient(
    90deg,
    rgba(200, 142, 61, 0.42) 0 10rpx,
    rgba(200, 142, 61, 0) 10rpx 18rpx
  ) left bottom / 100% 2rpx no-repeat;
}

.result-stat-card:last-child {
  background: none;
  padding-bottom: 0;
}

.result-stat-label-text {
  flex: 0 0 auto;
  font-size: 18px;
  letter-spacing: 0;
}

.result-stat-card-perfect .result-stat-label-text {
  color: #37a348;
}

.result-stat-card-good .result-stat-label-text {
  color: #6990bc;
}

.result-stat-card-miss .result-stat-label-text {
  color: #d85a67;
}

.result-stat-card-combo .result-stat-label-text {
  color: #ca7d23;
}

.result-stat-digit-run {
  flex: 0 0 auto;
  margin-left: auto;
  gap: 1px;
  justify-content: flex-end;
}

.result-stat-digit-run .result-digit-row {
  height: 1.5px;
}

.result-stat-digit-run .result-digit-pixel {
  width: 1.5px;
  height: 1.5px;
}

.result-actions {
  margin-top: auto;
  margin-bottom: 6rpx;
  display: flex;
  gap: 16rpx;
  transform: translateY(-20px);
}

.page-light.result-bg-parchment .result-actions,
.page-dark.result-bg-parchment .result-actions {
  width: 86%;
  max-width: 620rpx;
}

.result-secondary-wrap,
.result-primary-wrap {
  position: relative;
}

.result-secondary-wrap {
  flex: 1;
}

.result-primary-wrap {
  flex: 1;
}

.result-secondary-shadow,
.result-primary-shadow {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: -2rpx;
  left: 10rpx;
  background: rgba(88, 47, 40, 0.18);
}

.result-secondary-frame,
.result-primary-frame {
  position: relative;
  width: 100%;
  padding: 6rpx;
  box-sizing: border-box;
  background:
    linear-gradient(#654915, #654915) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#654915, #654915) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#654915, #654915) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#654915, #654915) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#654915, #654915) right center / 6rpx calc(100% - 24rpx) no-repeat;
  overflow: hidden;
}

.result-secondary-frame {
  background:
    linear-gradient(#654915, #654915) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#654915, #654915) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#654915, #654915) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#654915, #654915) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#654915, #654915) right center / 6rpx calc(100% - 24rpx) no-repeat;
}

.result-secondary-face,
.result-primary-face {
  width: 100%;
  min-height: 94rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-secondary-face {
  padding: 6rpx;
  background:
    linear-gradient(#fff0d7, #fff0d7) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#fff0d7, #fff0d7) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#fff0d7, #fff0d7) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#fff0d7, #fff0d7) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#fff0d7, #fff0d7) right center / 6rpx calc(100% - 24rpx) no-repeat;
}

.result-secondary-core {
  width: 100%;
  min-height: 78rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(180deg, rgba(255, 248, 226, 0.24) 0%, rgba(255, 248, 226, 0) 42%),
    #fff0d7;
}

.result-primary-face {
  padding: 0;
  background: transparent;
}

.result-primary-inner {
  width: 100%;
  min-height: 94rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(180deg, rgba(255, 240, 215, 0.32) 0%, rgba(255, 240, 215, 0) 38%),
    linear-gradient(#ee8d4a, #ee8d4a) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#ee8d4a, #ee8d4a) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#ee8d4a, #ee8d4a) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#ee8d4a, #ee8d4a) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#ee8d4a, #ee8d4a) right center / 6rpx calc(100% - 24rpx) no-repeat;
}

.result-button-text {
  font-size: 20px;
  letter-spacing: 0;
}

.result-home-button-text {
  color: #582f28;
}

.result-replay-button-text {
  color: #fff0d7;
}

.result-dark-blue-overlay {
  position: absolute;
  inset: 0;
  z-index: 100;
  pointer-events: none;
  background: rgba(79, 102, 138, 0.15);
}

.result-leaving-overlay {
  position: absolute;
  inset: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #6f86aa;
}

.result-leaving-overlay-dark {
  background: #6f86aa;
}

.result-leaving-overlay-light {
  background: #e8c08c;
}

.result-leaving-spinner {
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 8rpx solid transparent;
  border-color: rgba(23, 35, 61, 0.22);
  border-top-color: #17233d;
  border-right-color: #17233d;
  border-radius: 50%;
  animation: resultLeavingSpin 0.8s linear infinite;
}

.result-leaving-overlay-dark .result-leaving-spinner {
  border-color: rgba(23, 35, 61, 0.22);
  border-top-color: #17233d;
  border-right-color: #17233d;
}

.result-leaving-overlay-light .result-leaving-spinner {
  border-color: rgba(214, 164, 97, 0.2);
  border-top-color: #d6a461;
  border-right-color: #d6a461;
}

.result-leaving-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
}

.result-leaving-subtitle-image {
  display: block;
  width: 322rpx;
  height: auto;
  image-rendering: pixelated;
}

@keyframes resultLeavingSpin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
