.page-light .result-portal-spark,
.page-dark .result-portal-spark {
  --spark-fill: #ffb24b;
  --spark-shadow: rgba(255, 178, 75, 0.18);
  background: none;
  box-shadow: none;
  opacity: 0.44;
  overflow: visible;
  transform-origin: 50% 50%;
  animation-name: result-portal-spark-twinkle;
  animation-duration: 820ms;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}

.page-light .result-portal-spark .result-spark-glow,
.page-light .result-portal-spark .result-spark-outer,
.page-light .result-portal-spark .result-spark-core,
.page-light .result-portal-spark .result-spark-trail,
.page-dark .result-portal-spark .result-spark-glow,
.page-dark .result-portal-spark .result-spark-outer,
.page-dark .result-portal-spark .result-spark-core,
.page-dark .result-portal-spark .result-spark-trail {
  display: block;
  position: absolute;
  top: 50%;
  left: 50%;
  pointer-events: none;
}

.page-light .result-portal-spark .result-spark-glow,
.page-dark .result-portal-spark .result-spark-glow {
  width: 235%;
  height: 235%;
  border-radius: 999rpx;
  background: radial-gradient(
    circle at center,
    rgba(255, 242, 184, 0.18) 0%,
    rgba(255, 207, 121, 0.12) 44%,
    rgba(255, 178, 75, 0.05) 78%,
    rgba(255, 178, 75, 0) 100%
  );
  transform: translate(-50%, -50%);
}

.page-light .result-portal-spark .result-spark-outer,
.page-light .result-portal-spark .result-spark-core,
.page-dark .result-portal-spark .result-spark-outer,
.page-dark .result-portal-spark .result-spark-core {
  transform: translate(-50%, -50%) rotate(45deg);
}

.page-light .result-portal-spark .result-spark-outer,
.page-dark .result-portal-spark .result-spark-outer {
  width: 68%;
  height: 68%;
  background: var(--spark-fill, #ffb24b);
  box-shadow: 0 0 6rpx var(--spark-shadow, rgba(255, 178, 75, 0.18));
}

.page-light .result-portal-spark .result-spark-core,
.page-dark .result-portal-spark .result-spark-core {
  width: 28%;
  height: 28%;
  background: var(--spark-fill, #ffb24b);
  box-shadow:
    0 0 4rpx var(--spark-shadow, rgba(255, 178, 75, 0.18)),
    0 0 9rpx rgba(255, 207, 121, 0.12);
}

.page-light .result-portal-spark .result-spark-trail,
.page-dark .result-portal-spark .result-spark-trail {
  width: 2rpx;
  height: 5rpx;
  background: #ffcf79;
  opacity: 0.28;
  transform: translate(-50%, 72%);
}

.page-light .result-spark-tier-sm,
.page-dark .result-spark-tier-sm {
  width: 12rpx;
  height: 12rpx;
}

.page-light .result-spark-tier-md,
