@keyframes result-portal-spark-twinkle {
  0%,
  100% {
    opacity: 0.28;
    transform: scale(0.9);
  }

  50% {
    opacity: 0.74;
    transform: scale(1.08);
  }
}

@keyframes result-spark-twinkle {
  0% {
    opacity: 0.18;
    box-shadow:
      0 0 1rpx rgba(255, 248, 205, 0.38),
      0 0 4rpx rgba(255, 190, 76, 0.12);
  }

  8% {
    opacity: 1;
    box-shadow:
      0 0 5rpx rgba(255, 250, 216, 0.96),
      0 0 12rpx rgba(255, 188, 72, 0.38);
  }

  13% {
    opacity: 0.34;
    box-shadow:
      0 0 2rpx rgba(255, 248, 205, 0.46),
      0 0 6rpx rgba(255, 190, 76, 0.14);
  }

  20% {
    opacity: 0.86;
    box-shadow:
      0 0 4rpx rgba(255, 250, 216, 0.72),
      0 0 9rpx rgba(255, 188, 72, 0.26);
  }

  26%,
  100% {
    opacity: 0.24;
    box-shadow:
      0 0 1rpx rgba(255, 248, 205, 0.34),
      0 0 4rpx rgba(255, 190, 76, 0.1);
  }
}

.result-hero {
  position: relative;
  width: 100%;
  height: 318rpx;
  z-index: 3;
  pointer-events: none;
}

.result-hero-shadow {
  position: absolute;
  left: 50%;
  bottom: calc(14rpx - 50px);
  width: 230rpx;
  height: 48rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  opacity: 0.54;
  background: radial-gradient(
    ellipse at center,
    rgba(67, 28, 18, 0.32) 0%,
    rgba(67, 28, 18, 0.2) 42%,
    rgba(67, 28, 18, 0.04) 74%,
    rgba(67, 28, 18, 0) 100%
  );
}

.result-rabbit-wrap {
  position: absolute;
  left: calc(50% + 15px);
  bottom: calc(-10rpx - 50px);
  transform: translateX(-50%) scale(1.2);
  transform-origin: 50% 100%;
}

.result-rabbit-sprite {
  width: 340rpx;
  height: 340rpx;
}

.result-rabbit-frame {
  display: block;
  width: 340rpx;
  height: 340rpx;
  image-rendering: pixelated;
}

.result-panel-wrap {
  position: relative;
  z-index: 4;
  margin-top: 0;
}

.page-light.result-bg-parchment .result-panel-wrap,
.page-dark.result-bg-parchment .result-panel-wrap {
  width: 92%;
  max-width: 620rpx;
  margin-left: auto;
  margin-right: auto;
}

.result-panel-outer {
  position: relative;
  width: 100%;
  padding: 6rpx;
  box-sizing: border-box;
  background:
    linear-gradient(#ddbc6c, #ddbc6c) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#ddbc6c, #ddbc6c) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#ddbc6c, #ddbc6c) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#ddbc6c, #ddbc6c) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#ddbc6c, #ddbc6c) right center / 6rpx calc(100% - 24rpx) no-repeat;
  overflow: hidden;
}

.result-panel-face {
  width: 100%;
  padding: 6rpx;
  box-sizing: border-box;
  background:
    linear-gradient(#fbeec2, #fbeec2) center / calc(100% - 12rpx) calc(100% - 12rpx) no-repeat,
    linear-gradient(#fbeec2, #fbeec2) top center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#fbeec2, #fbeec2) bottom center / calc(100% - 24rpx) 6rpx no-repeat,
    linear-gradient(#fbeec2, #fbeec2) left center / 6rpx calc(100% - 24rpx) no-repeat,
    linear-gradient(#fbeec2, #fbeec2) right center / 6rpx calc(100% - 24rpx) no-repeat;
  overflow: hidden;
}

.result-panel-core {
  width: 100%;
  min-height: calc(476rpx - 10rpx);
  padding: 30rpx 30rpx 22rpx;
  box-sizing: border-box;
  background: transparent;
}

.result-text-block {
  display: block;
  line-height: 1;
  white-space: nowrap;
}

.result-text-segments {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: nowrap;
  min-width: 0;
}

.result-text-segment {
